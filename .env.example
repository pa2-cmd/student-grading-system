# Copy this file to .env.local and fill in values from
# Supabase Dashboard -> Project Settings -> API (or "Connect" -> App Frameworks).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon" public key. Never put the service_role/secret key here.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
